# ---- 运行数据 / 个人数据（不入库，仅限插件根目录）----
/favorite_files/
/workflows/
/drafts/
/.runtime/
/mobile_favorites.json
/mobile_history.json
/mobile_settings.json
/mobile_settings.json.bak
/remote_settings.json
# 原子写入中断时留下的临时文件（例如 mobile_history.json.<hex>.tmp，体积跟原文件一样大）
/*.json.*.tmp

# ---- 面板源码的构建依赖与中间产物（构建产物 panel.js/panel.css 反而要入库，见 mobile/panel）----
/mobile/panel/node_modules/
/mobile/panel/dist/
/mobile/panel/*.tsbuildinfo
/mobile/panel/node_modules/.tmp/

# ---- Python 缓存 ----
__pycache__/
*.pyc

# ---- 大文件（52MB，超托管限制；代码会自动从 GitHub 下载）----
/bin/cloudflared.exe
tests/screenshots/
